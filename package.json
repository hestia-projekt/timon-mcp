{
  "name": "@hestia-projekt/timon-mcp",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Host plugin that exposes a stateless Streamable HTTP MCP server. Clients mandate the pilot. POST /mcp requires a bearer token.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "migrations",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hestia-projekt/timon-mcp.git"
  },
  "timon": {
    "id": "timon-mcp",
    "apiVersion": 15,
    "kind": "behavior",
    "label": "Timon MCP",
    "description": "Streamable HTTP MCP server that forwards mandates to the pilot. POST /mcp requires a bearer token.",
    "permissions": [
      "http:public",
      "missions:spawn",
      "missions:read",
      "missions:control",
      "kanban:read",
      "kanban:write",
      "settings",
      "secrets:read",
      "storage:sql"
    ],
    "settings": [
      { "key": "public_url", "type": "string", "label": "Public URL of the plugin, without a trailing slash" },
      { "key": "issuer", "type": "string", "label": "OAuth issuer, without a trailing slash" },
      { "key": "resource", "type": "string", "label": "Public address of the MCP endpoint (resource parameter)" },
      { "key": "identity_header", "type": "string", "label": "Identity header, read only on /oauth/authorize" },
      { "key": "expected_right", "type": "string", "label": "Expected right, documentary: no right header is read", "default": "timon" },
      { "key": "email_allowlist", "type": "string", "label": "Allowed addresses, separated by commas. Empty: refuse everyone" }
    ],
    "secrets": [
      {
        "name": "TIMON_MCP_BEARER_TOKEN",
        "mode": "read",
        "why": "Static bearer token for local CLIs. Granted to the plugin, never written in the repository."
      }
    ],
    "migrations": "migrations",
    "routes": {
      "publicPaths": [
        { "method": "POST", "path": "/mcp" },
        { "method": "GET", "path": "/oauth/protected-resource" },
        { "method": "GET", "path": "/oauth/authorization-server" },
        { "method": "POST", "path": "/oauth/register" },
        { "method": "GET", "path": "/oauth/authorize" },
        { "method": "POST", "path": "/oauth/authorize" },
        { "method": "POST", "path": "/oauth/token" }
      ]
    }
  }
}
