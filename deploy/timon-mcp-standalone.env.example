# Operator environment for the standalone host.
# systemd loads a copy of this file through EnvironmentFile=.
# Copy it to ~/.config/timon-mcp/standalone.env and fill it there.
# Do not commit the filled copy. The webhook secret is created by the
# operator and is never written to the repository, the tests, or the logs.

# TIMON_MCP_PORT=3098
# TIMON_DAEMON_URL=http://127.0.0.1:3000
# TIMON_DAEMON_TOKEN_FILE=%h/.timon/daemon-token
# TIMON_MCP_DB=%h/.timon-mcp/state.db
# TIMON_MCP_SETTINGS=%h/.config/timon-mcp/settings.json
# TIMON_MCP_BEARER_TOKEN=
# TIMON_MCP_TRUST_PROXY=1
# TIMON_MCP_SPAWN_MAX=5
# TIMON_MCP_SPAWN_WINDOW_MS=3600000

# Outbound notification of questions, kanban plans, and tool approvals.
# Leave the URL empty to record card ids locally and send nothing.
# https is required. http is accepted only for 127.0.0.1, localhost, or ::1.
# No userinfo, query, or hash. Redirects are not followed.
# TIMON_MCP_PENDING_WEBHOOK_URL=https://receiver.example/hooks/pending
# Required when the URL is set. 16 to 512 characters. Not a settings key.
# TIMON_MCP_PENDING_WEBHOOK_SECRET=
# Gap between polls, in milliseconds. Default 5000. Minimum 1000. Maximum 60000.
# TIMON_MCP_PENDING_INTERVAL_MS=5000
